// Test sheet F-01: a pump jetty in the wave flume.
//
// The legs stand on the flume bed in a strong current; then the paddle
// sends a surge down the flume. Water pushes on every submerged member
// (drag and inertia), so slim, open legs help and a deck low enough for
// the crest to reach catches far more.
(
    id: "flood_jetty",
    sheet: "F-01",
    group: "Water",
    title: "Pump jetty in the wave channel",
    brief: "A 3 t pump house has to stay up on a platform in the wave channel while a flood runs through it. Build the jetty that holds it.",
    steps: [
        "Stand legs on the four foundations on the floor of the channel, under the water.",
        "Bring them up to the four orange foot marks 1 m above the table: the pump house stands on nodes there.",
        "The flood current pushes on every leg in the water, then a 1.8 m wave runs down the channel and reaches the platform. Slim, braced legs catch less water.",
        "The pump house only rests on its feet: if the platform rocks or tilts, it slides off and the test fails.",
    ],
    limits: (
        volume: (min: (-2.0, -3.2, -2.0), max: (2.0, 1.5, 2.0)),
        budget: Some(130000.0),
        max_mass: Some(3000.0),
        materials: None,
    ),
    anchors: [
        (name: "A", position: (-1.5, -3.2, -1.5), kind: Fixed),
