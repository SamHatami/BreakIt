// Test sheet F-02: a floating footbridge across the flume.
//
// Only the near bank takes a mooring: two pins that hold the end in place
// but let it swing. The far bank is soft and takes nothing, so the bridge
// has to float. Pontoons lift what they displace less what they weigh;
// waves along the flume pitch them, a crowd walks on.
(
    id: "pontoon_footbridge",
    sheet: "F-02",
    group: "Water",
    title: "Floating footbridge",
    brief: "Build a footbridge that floats across the wave channel. Only the near bank can hold it; the far bank is too soft to carry anything.",
    steps: [
        "The path is the dashed line across the water. Put nodes along it no more than 1.5 m apart and join them.",
        "Tie the near end to the two pin foundations on the bank. Nothing else holds it: the rest has to float.",
        "Pontoons are sealed floats: put them in the water under the path. A large one lifts about 200 kg per metre.",
        "A crowd walks on while waves roll down the channel. The path may not sink more than 30 cm.",
    ],
    limits: (
        volume: (min: (-2.5, -2.0, -3.6), max: (2.5, 0.6, 2.9)),
        budget: Some(300000.0),
        max_mass: Some(6000.0),
        materials: None,
    ),
    anchors: [
        (name: "W", position: (-0.75, 0.0, -3.5), kind: Pinned),
        (name: "E", position: (0.75, 0.0, -3.5), kind: Pinned),
    ],
    deck: Some((
        from: (0.0, 0.0, -3.5),
        to: (0.0, 0.0, 2.8),
        width: 0.9,
        height: 0.25,
        max_gap: 1.5,
    )),
    events: [
        // Full from the start: the bridge must float while its weight comes on.
        Water(
            name: "Waves 0.4 m",
            start: -1.0,
            ramp: 0.0,
            bed: -3.2,
            level: -1.0,
            current: (0.6, 0.0, 0.0),
            wave: Some(Regular(height: 0.4, period: 2.5, direction: (1.0, 0.0, 0.0))),
        ),
        DeckLoad(name: "Crowd 2 kN/m", start: 1.0, ramp: 3.0, per_metre: 2000.0),
    ],
    duration: 12.0,
    settle: 1.0,
    collapse: (displacement: 0.6, max_broken_fraction: 0.25),
    overload: None,
    objectives: [
        DeckDeflection(limit: 0.3),
        NoBreaks,
    ],
    scoring: (
        target_cost: 200000.0,
        target_mass: 3200.0,
        margin_band: (1.25, 2.0),
        weights: (cost: 0.3, mass: 0.15, margin: 0.25, objectives: 0.3),
        stars: (0.6, 0.85),
    ),
)
